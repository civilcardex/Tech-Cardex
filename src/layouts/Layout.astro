---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title = 'TechCardex' } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="TechCardex: ecosistema de software enterprise. Reverzo, Suti Finanzas y CivilCardex — aplicaciones móviles y plataformas de ingeniería para organizaciones globales." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Ecosistema de software enterprise: Reverzo, Suti Finanzas y CivilCardex. Aplicaciones móviles y plataformas de ingeniería para organizaciones globales." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href="/logo.png" />
  </head>
  <body class="font-body-md text-body-md text-on-surface antialiased lg:h-dvh lg:overflow-hidden lg:flex lg:flex-col">
    <div class="scroll-progress fixed top-0 left-0 right-0 h-0.5 z-[60]" data-progress></div>
    <Header />
    <main class="w-full pt-20 lg:flex-1 lg:min-h-0">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      document.documentElement.classList.add('js');
      window.addEventListener('DOMContentLoaded', () => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /**
         * Ejecuta un inicializador de forma aislada: si falla, los demas siguen.
         * @param {string} name
         * @param {() => void} init
         * @returns {void}
         */
        const safeInit = (name, init) => {
          try { init(); } catch (err) { console.error('[init:' + name + ']', err); }
        };

        /** Sombra extra del header al hacer scroll. */
        const initHeader = () => {
          const header = document.querySelector('[data-header]');
          if (!header) return;
          const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        };

        /** Barra de progreso de lectura (scaleX segun avance). */
        const initProgress = () => {
          const bar = document.querySelector('[data-progress]');
          if (!bar) return;
          const onScroll = () => {
            const max = document.documentElement.scrollHeight - window.innerHeight;
            bar.style.transform = 'scaleX(' + (max > 0 ? window.scrollY / max : 0).toFixed(4) + ')';
          };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll, { passive: true });
        };

        /**
         * Anima un contador [data-count-to] hasta su valor final.
         * @param {HTMLElement} el
         * @returns {void}
         */
        const runCount = (el) => {
          const target = parseFloat(el.dataset.countTo);
          const decimals = parseInt(el.dataset.decimals || '0', 10);
          const start = performance.now();
          const duration = 1400;
          const tick = (now) => {
            const p = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = (target * eased).toFixed(decimals);
            if (p < 1) setTimeout(() => tick(performance.now()), 16);
          };
          tick(start);
        };

        /** Contadores: se animan al entrar en viewport (texto final si reduced-motion). */
        const initCounters = () => {
          const counters = document.querySelectorAll('[data-count-to]');
          if (reduced) {
            counters.forEach((el) => {
              el.textContent = parseFloat(el.dataset.countTo).toFixed(parseInt(el.dataset.decimals || '0', 10));
            });
            return;
          }
          const onScroll = () => {
            counters.forEach((el) => {
              if (el.dataset.done) return;
              const r = el.getBoundingClientRect();
              if (r.top < window.innerHeight && r.bottom > 0) {
                el.dataset.done = '1';
                runCount(el);
              }
            });
          };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        };

        /** Aparicion [data-reveal] por scroll + red de seguridad a 4s. */
        const initReveals = () => {
          const pending = new Set(document.querySelectorAll('[data-reveal]'));
          const check = () => {
            const vh = window.innerHeight;
            pending.forEach((el) => {
              const r = el.getBoundingClientRect();
              if (r.top < vh - 40 && r.bottom > 0) {
                el.classList.add('revealed');
                pending.delete(el);
              }
            });
          };
          if (reduced) {
            pending.forEach((el) => el.classList.add('revealed'));
            return;
          }
          window.addEventListener('scroll', check, { passive: true });
          window.addEventListener('resize', check, { passive: true });
          check();
          // Red de seguridad: si en 4s no ha llegado ningun scroll, revelar todo
          let scrolled = false;
          window.addEventListener('scroll', () => { scrolled = true; }, { passive: true, once: true });
          setTimeout(() => {
            if (scrolled) return;
            pending.forEach((el) => el.classList.add('revealed'));
            pending.clear();
          }, 4000);
        };

        /** Carrusel 3D coverflow: flechas, dots, arrastre y accesibilidad. */
        const initCarousel = () => {
          document.querySelectorAll('[data-caro3d]').forEach((caro) => {
            const faces = [...caro.querySelectorAll('[data-caro-face]')];
            const dots = [...caro.querySelectorAll('[data-caro-dot]')];
            const n = faces.length;
            if (!n) return;
            let cur = 0;

            /** Sincroniza posicion visual, dots y accesibilidad teclado. */
            const upd = () => {
              faces.forEach((f, i) => {
                const rel = ((i - cur) % n + n) % n;
                f.dataset.pos = rel === 0 ? '0' : 'hidden';
                f.querySelectorAll('a').forEach((a) => { a.tabIndex = rel === 0 ? 0 : -1; });
              });
              dots.forEach((d, di) => {
                d.classList.toggle('is-active', di === cur);
                d.setAttribute('aria-current', di === cur ? 'true' : 'false');
              });
              caro.dataset.caroCurrent = String(cur);
            };

            /**
             * Avanza el carrusel.
             * @param {number} dir -1 o 1
             * @returns {void}
             */
            /**
             * Avanza el carrusel; la carta que sale se "baraja" hacia el fondo.
             * @param {number} dir -1 o 1
             * @returns {void}
             */
            const go = (dir) => {
              const leaving = faces[cur];
              leaving.classList.add('deal-out');
              leaving.addEventListener('animationend', () => leaving.classList.remove('deal-out'), { once: true });
              cur = (cur + dir + n) % n;
              upd();
            };

            caro.querySelector('[data-caro-prev]').addEventListener('click', () => go(-1));
            caro.querySelector('[data-caro-next]').addEventListener('click', () => go(1));
            dots.forEach((d, di) => d.addEventListener('click', () => { cur = di; upd(); }));

            // Arrastre / swipe: cancela pointer cancelado y suprime click post-drag
            let sx = null;
            let dragged = false;
            const zone = caro.querySelector('.caro-perspective');
            zone.addEventListener('pointerdown', (e) => { sx = e.clientX; dragged = false; });
            zone.addEventListener('pointermove', (e) => {
              if (sx !== null && Math.abs(e.clientX - sx) > 8) dragged = true;
            });
            window.addEventListener('pointercancel', () => { sx = null; });
            window.addEventListener('pointerup', (e) => {
              if (sx === null) return;
              const dx = e.clientX - sx;
              sx = null;
              if (Math.abs(dx) > 48) go(dx < 0 ? 1 : -1);
            });
            zone.addEventListener('click', (e) => {
              if (dragged) { e.preventDefault(); dragged = false; }
            }, true);
            upd();
          });
        };

        safeInit('header', initHeader);
        safeInit('progress', initProgress);
        safeInit('counters', initCounters);
        safeInit('reveals', initReveals);
        safeInit('carousel', initCarousel);
      });
    </script>
  </body>
</html>
