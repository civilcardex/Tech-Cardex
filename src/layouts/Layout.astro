---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title = 'TechCardex' } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="TechCardex: ecosistema de software enterprise. Reverzo, Suti Finanzas y CivilCardex — aplicaciones móviles y plataformas de ingeniería para organizaciones globales." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Ecosistema de software enterprise: Reverzo, Suti Finanzas y CivilCardex. Aplicaciones móviles y plataformas de ingeniería para organizaciones globales." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href="/logo.png" />
  </head>
  <body class="font-body-md text-body-md text-on-surface antialiased lg:h-dvh lg:overflow-y-auto lg:overflow-x-hidden lg:flex lg:flex-col">
    <div class="scroll-progress fixed top-0 left-0 right-0 h-0.5 z-[60]" data-progress></div>
    <Header />
    <main class="w-full pt-20 lg:flex-1 lg:min-h-0">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      document.documentElement.classList.add('js');
      window.addEventListener('DOMContentLoaded', () => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /**
         * Ejecuta un inicializador de forma aislada: si falla, los demas siguen.
         * @param {string} name
         * @param {() => void} init
         * @returns {void}
         */
        const safeInit = (name, init) => {
          try { init(); } catch (err) { console.error('[init:' + name + ']', err); }
        };

        /** Sombra extra del header al hacer scroll. */
        const initHeader = () => {
          const header = document.querySelector('[data-header]');
          if (!header) return;
          const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        };

        /** Barra de progreso de lectura (scaleX segun avance). */
        const initProgress = () => {
          const bar = document.querySelector('[data-progress]');
          if (!bar) return;
          const onScroll = () => {
            const max = document.documentElement.scrollHeight - window.innerHeight;
            bar.style.transform = 'scaleX(' + (max > 0 ? window.scrollY / max : 0).toFixed(4) + ')';
          };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll, { passive: true });
        };

        /** Header sombra + barra de progreso: un solo listener de scroll. */
        const initChrome = () => {
          const header = document.querySelector('[data-header]');
          const bar = document.querySelector('[data-progress]');
          const onScroll = () => {
            if (header) header.classList.toggle('is-scrolled', window.scrollY > 8);
            if (bar) {
              const max = document.documentElement.scrollHeight - window.innerHeight;
              bar.style.transform = 'scaleX(' + (max > 0 ? window.scrollY / max : 0).toFixed(4) + ')';
            }
          };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll, { passive: true });
        };

        /** Carrusel 3D coverflow: flechas, dots, arrastre y accesibilidad. */
        const initCarousel = () => {
          document.querySelectorAll('[data-caro3d]').forEach((caro) => {
            const faces = [...caro.querySelectorAll('[data-caro-face]')];
            const dots = [...caro.querySelectorAll('[data-caro-dot]')];
            const n = faces.length;
            if (!n) return;
            let cur = 0;
            let turn = 0; // acumulado en grados: siempre gira hacia la derecha

            /** Sincroniza posicion visual, dots y accesibilidad teclado. */
            const spin = caro.querySelector('[data-caro-spin]');
            const setRadius = () => {
              const fw = faces[0].offsetWidth;
              if (fw) caro.style.setProperty('--rr', (fw / 2 / Math.tan(Math.PI / 3)).toFixed(1) + 'px');
            };
            setRadius();
            window.addEventListener('resize', setRadius, { passive: true });
            const upd = () => {
              if (spin) spin.style.transform = 'rotateY(' + (-turn) + 'deg)';
              faces.forEach((f, i) => {
                const rel = ((i - cur) % n + n) % n;
                f.dataset.pos = rel === 0 ? '0' : 'hidden';
                f.querySelectorAll('a').forEach((a) => { a.tabIndex = rel === 0 ? 0 : -1; });
              });
              dots.forEach((d, di) => {
                d.classList.toggle('is-active', di === cur);
                d.setAttribute('aria-current', di === cur ? 'true' : 'false');
              });
              caro.dataset.caroCurrent = String(cur);
            };

            /**
             * Gira SIEMPRE hacia la derecha (+120deg), sin reiniciar al dar la
             * vuelta completa; ambos botones avanzan el mazo en el mismo sentido.
             * @param {number} dir -1 o 1 (ambos giran a la derecha)
             * @returns {void}
             */
            const go = (dir) => {
              turn += 120;
              cur = ((turn / 120) % n + n) % n;
              upd();
            };

            /**
             * Gira hacia la carta dada por el camino mas corto hacia la derecha.
             * @param {number} idx indice de la carta destino
             * @returns {void}
             */
            const goToIndex = (idx) => {
              const delta = ((idx * 120 - turn) % (n * 120) + (n * 120)) % (n * 120);
              turn += delta;
              cur = idx;
              upd();
            };

            let timer = 0;
            const startAuto = () => {
              clearInterval(timer);
              timer = setInterval(() => {
                if (document.hidden) return;
                const r = caro.getBoundingClientRect();
                const visible = r.top < innerHeight && r.bottom > 0;
                if (visible) go(1);
              }, 10000);
            };
            const goUser = (dir) => { go(dir); startAuto(); };
            caro.querySelector('[data-caro-prev]').addEventListener('click', () => goUser(-1));
            caro.querySelector('[data-caro-next]').addEventListener('click', () => goUser(1));
            dots.forEach((d, di) => d.addEventListener('click', () => { const delta = ((di * 120 - turn) % (n * 120) + (n * 120)) % (n * 120); turn += delta; cur = di; upd(); startAuto(); }));

            // Enlaces externos (p. ej. footer) que deben abrir una tarjeta concreta
            document.querySelectorAll('[data-caro-goto]').forEach((link) => {
              link.addEventListener('click', (e) => {
                const idx = faces.findIndex((f) => f.dataset.slug === link.dataset.caroGoto);
                if (idx < 0) return;
                e.preventDefault();
                goToIndex(idx);
                caro.closest('section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
              });
            });

            // Arrastre / swipe: cancela pointer cancelado y suprime click post-drag
            let sx = null;
            let dragged = false;
            const zone = caro.querySelector('.caro-perspective');
            zone.addEventListener('pointerdown', (e) => { sx = e.clientX; dragged = false; });
            zone.addEventListener('pointermove', (e) => {
              if (sx !== null && Math.abs(e.clientX - sx) > 8) dragged = true;
            });
            window.addEventListener('pointercancel', () => { sx = null; });
            window.addEventListener('pointerup', (e) => {
              if (sx === null) return;
              const dx = e.clientX - sx;
              sx = null;
              if (Math.abs(dx) > 48) goUser(dx < 0 ? 1 : -1);
            });
            zone.addEventListener('click', (e) => {
              if (dragged) { e.preventDefault(); dragged = false; }
            }, true);
            upd();
            startAuto();
          });
        };

        safeInit('chrome', initChrome);
        safeInit('carousel', initCarousel);
      });
    </script>
  </body>
</html>
