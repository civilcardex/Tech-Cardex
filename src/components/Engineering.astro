---
const PILLARS = [
  {
    icon: 'cloud_sync',
    color: 'text-primary',
    title: 'Arquitectura Cloud Nativa',
    desc: 'Diseños multi-nube preparados para elasticidad inmediata en AWS, Google Cloud y Azure, asegurando continuidad operativa bajo cargas pico impredecibles.',
    mono: 'Terraform • Kubernetes • Serverless',
    monoColor: 'text-primary',
  },
  {
    icon: 'hub',
    color: 'text-secondary',
    title: 'Microservicios Escalables',
    desc: 'Estructuras modulares basadas en eventos (Event-Driven Architecture) con gRPC y Apache Kafka para sincronización ultrarrápida sin acoplamientos rígidos.',
    mono: 'Kafka • gRPC • Go • Node.js',
    monoColor: 'text-secondary',
  },
  {
    icon: 'verified_user',
    color: 'text-primary-container',
    title: 'Ciberseguridad & Compliance',
    desc: 'Estándares bancarios de encriptación en tránsito y reposo, cumplimiento regulatorio estricto (ISO 27001, GDPR) y diseño Zero-Trust de raíz.',
    mono: 'Zero-Trust • Vault • ISO 27001',
    monoColor: 'text-primary-container',
  },
  {
    icon: 'psychology',
    color: 'text-tertiary-container',
    title: 'Inteligencia Artificial Aplicada',
    desc: 'Integración de modelos predictivos y LLMs afinados para automatizar flujos operativos, categorización inteligente y extracción estructurada de información.',
    mono: 'RAG • PyTorch • Fine-Tuning',
    monoColor: 'text-tertiary-container',
  },
];
---

<section class="w-full bg-surface py-space-4xl">
  <div class="max-w-max-width-content mx-auto px-gutter-desktop">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-2xl items-center mb-space-3xl">
      <div class="lg:col-span-6 space-y-space-md">
        <div class="inline-block px-3 py-1 rounded-full bg-surface-container-high text-primary font-label-sm text-label-sm font-semibold uppercase">
          Ingeniería Especializada
        </div>
        <h2 class="font-headline-xl text-headline-xl text-on-surface tracking-tight">Desarrollo de Software a Medida de Misión Crítica</h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant">
          Construimos sistemas resilientes para organizaciones que no pueden permitirse caídas de servicio, fallos de seguridad o cuellos de botella de infraestructura.
        </p>
      </div>
      <div class="lg:col-span-6 flex flex-wrap lg:justify-end gap-space-md">
        <div class="p-space-md rounded-xl bg-surface-container-low shadow-sm flex items-center gap-space-sm">
          <span class="material-symbols-outlined text-primary text-3xl">terminal</span>
          <div>
            <div class="font-headline-sm text-headline-sm text-on-surface">100% Código Limpio</div>
            <div class="font-body-sm text-body-sm text-on-surface-variant">Auditorías SAST &amp; DAST continuas</div>
          </div>
        </div>
        <div class="p-space-md rounded-xl bg-surface-container-low shadow-sm flex items-center gap-space-sm">
          <span class="material-symbols-outlined text-secondary text-3xl">speed</span>
          <div>
            <div class="font-headline-sm text-headline-sm text-on-surface">Arquitectura Decoupled</div>
            <div class="font-body-sm text-body-sm text-on-surface-variant">Despliegues sin interrupciones</div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-space-lg">
      {PILLARS.map((p) => (
        <div class="p-space-xl rounded-2xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow">
          <div class={`w-12 h-12 rounded-lg bg-surface-container-high ${p.color} flex items-center justify-center mb-space-md`}>
            <span class="material-symbols-outlined text-2xl">{p.icon}</span>
          </div>
          <h3 class="font-headline-sm text-headline-sm text-on-surface mb-space-xs font-bold">{p.title}</h3>
          <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">{p.desc}</p>
          <div class={`mt-space-md font-mono-code text-mono-code ${p.monoColor}`}>{p.mono}</div>
        </div>
      ))}
    </div>
  </div>
</section>