---
const ASSURANCES = [
  { icon: 'verified', text: 'Sin compromisos de permanencia' },
  { icon: 'lock', text: 'Acuerdo de Confidencialidad (NDA) instantáneo' },
  { icon: 'schedule', text: 'Respuesta en menos de 4 horas hábiles' },
];
---

<section class="w-full bg-surface py-space-4xl" id="contacto-cta">
  <div class="max-w-max-width-content mx-auto px-gutter-desktop">
    <div class="relative overflow-hidden rounded-3xl bg-surface-container-lowest shadow-xl p-space-2xl lg:p-space-3xl">
      <div class="h-2 w-full absolute top-0 left-0 bg-gradient-to-r from-primary via-secondary to-tertiary-container"></div>
      <div class="absolute -bottom-20 -right-20 w-80 h-80 bg-surface-container-high rounded-full blur-2xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl mx-auto text-center space-y-space-md">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-container text-primary font-label-sm text-label-sm">
          <span class="material-symbols-outlined text-base">rocket_launch</span>
          Implementación Ágil &amp; Acompañamiento Técnico Dedicado
        </div>
        <h2 class="font-headline-xl text-headline-xl text-on-surface font-extrabold tracking-tight">
          Empieza a transformar tu operativa con TechCardex hoy mismo
        </h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl mx-auto">
          Agenda una sesión guiada con uno de nuestros arquitectos de software para evaluar tus flujos de trabajo actuales y ver nuestros productos en acción.
        </p>

        <form class="pt-space-md max-w-lg mx-auto flex flex-col sm:flex-row gap-space-xs" onsubmit="return false;">
          <div class="relative flex-1">
            <span class="material-symbols-outlined absolute left-3.5 top-3 text-outline text-xl">mail</span>
            <input class="w-full pl-11 pr-4 py-3 bg-surface-container-low rounded-lg font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest transition-all shadow-inner" id="corporate-email" placeholder="ejemplo@tuempresa.com" required="" type="email" />
          </div>
          <button class="py-3 px-space-lg bg-tertiary-container hover:bg-tertiary text-on-tertiary font-label-md text-label-md rounded-lg shadow-md hover:shadow-lg transition-all whitespace-nowrap flex items-center justify-center gap-2" type="button">
            <span>Solicitar Asesoría</span>
            <span class="material-symbols-outlined text-lg">arrow_forward</span>
          </button>
        </form>

        <div class="flex flex-wrap items-center justify-center gap-space-lg text-outline font-label-sm text-label-sm pt-space-xs">
          {ASSURANCES.map((a) => (
            <span class="flex items-center gap-1.5">
              <span class="material-symbols-outlined text-base text-primary">{a.icon}</span>
              {a.text}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>