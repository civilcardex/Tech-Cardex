---
const PRODUCTS = [
  {
    badge: 'Plataforma Web • B2B',
    badgeBg: 'bg-white/90 ring-1 ring-black/10',
    badgeText: 'text-[#6b5410]',
    name: 'CivilCardex',
    tagline: 'Plataforma web de inteligencia en ingeniería civil',
    taglineColor: 'text-[#9a7b1f]',
    desc: 'Plataforma web de inteligencia en ingeniería civil: módulos que cubren diseño hidrosanitario, estructural, topografía y vías, con verificación normativa automática (IPC/UPC, NFPA, NTC, NSR-10, RAS 2000) y memorias de cálculo exportables.',
    checkColor: 'text-[#9a7b1f]',
    features: [
      'Diseño de redes sobre planos con cálculo en tiempo real',
      'Estructuras, terreno y diseño geométrico de vías',
      'Presupuestos y APU con memorias de cálculo exportables',
    ],
    cta: 'Explorar CivilCardex',
    playBadge: false,
    href: 'https://civilcardex.com',
    external: true,
    hoverBg: 'hover:bg-[#efe3c0]',
    hoverText: 'hover:text-[#4a3a10]',
    textColor: 'text-[#8a6a15]',
    logo: '/civilCardexlogo-t96.png',
    panelFrom: 'from-[#1d1d23]',
    panelTo: 'to-[#0a0a0d]',
    nameColor: 'text-[#ffd54a]',
    faceInk: '#f2f2f4',
    faceInkSoft: 'rgba(242, 242, 244, 0.7)',
  },
  {
    badge: 'App Móvil • Google Play',
    badgeBg: 'bg-white/90 ring-1 ring-black/10',
    badgeText: 'text-[#6b5410]',
    name: 'Reverzo',
    tagline: 'Compra, vende y revende libros',
    taglineColor: 'text-[#8a6a15]',
    desc: 'Marketplace móvil moderado para comprar y vender libros usados y nuevos entre lectores. Publica con fotos y filtros, coordina el trato por chat y únete a clubes de lectura activos.',
    checkColor: 'text-[#8a6a15]',
    features: [
      'Publica libros con fotos, precios, estado y categoría',
      'Chat directo comprador–vendedor y calculadora de envíos',
      'Comunidades de lectura públicos y privados con chat y valoraciones',
    ],
    cta: 'Ver en Google Play',
    playBadge: true,
    href: 'https://play.google.com/store/apps/details?id=com.diegocv60.applibros',
    external: true,
    hoverBg: 'hover:bg-[#efe3c0]',
    hoverText: 'hover:text-[#4a3a10]',
    textColor: 'text-[#8a6a15]',
    logo: '/logo_Reverzo-t96.png',
    panelFrom: 'from-[#1d1d23]',
    panelTo: 'to-[#0a0a0d]',
    nameColor: 'text-[#0e4a6b]',
    faceInk: '#f2f2f4',
    faceInkSoft: 'rgba(242, 242, 244, 0.7)',
  },
  {
    badge: 'App Móvil • Google Play',
    badgeBg: 'bg-white/90 ring-1 ring-black/10',
    badgeText: 'text-[#6b5410]',
    name: 'Suti',
    tagline: 'Lleva el control de tu vida financiera, tu saldo y tus gastos',
    taglineColor: 'text-[#6b7080]',
    desc: 'Lleva tu saldo en fondos, registra gastos por categoría y divide los gastos compartidos con tus amigos. Historial claro, gráficos de balance y todo gratis desde tu celular.',
    checkColor: 'text-[#6b7080]',
    features: [
      'Ingresos, fondos y saldos actualizados en tiempo real',
      'Gastos por categorías, historial por día o mes y gráficos de balance',
      'Gastos compartidos con contactos y división en porcentajes',
    ],
    cta: 'Ver en Google Play',
    playBadge: true,
    href: 'https://play.google.com/store/search?q=Suti%20Finanzas&c=apps',
    external: true,
    hoverBg: 'hover:bg-[#efe3c0]',
    hoverText: 'hover:text-[#4a3a10]',
    textColor: 'text-[#8a6a15]',
    logo: '/suti-icon-t96.png',
    panelFrom: 'from-[#1d1d23]',
    panelTo: 'to-[#0a0a0d]',
    nameColor: 'text-[#5a2d0c]',
    faceInk: '#f2f2f4',
    faceInkSoft: 'rgba(242, 242, 244, 0.7)',
  },
];
---

<section class="w-full relative overflow-hidden lg:h-full" id="productos-insignia" style="background:linear-gradient(180deg, #c39a3a 0%, #a8862f 60%, #8f7026 100%)">
  <div aria-hidden="true" class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse 62% 56% at 50% 50%, #fffef8 0%, #fdf3cf 32%, #ecd28a 58%, #c39a3a 82%, #a8862f 100%)"></div>

  <div aria-hidden="true" class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="flow-wrap" style="transform:rotate(-14deg)">
      <div class="flow-line" style="top:20%; animation-duration:26s; animation-delay:-4s"></div>
      <div class="flow-line" style="top:52%; width:45%; animation-duration:34s; animation-delay:-18s"></div>
    </div>
    <div class="flow-wrap" style="transform:rotate(11deg)">
      <div class="flow-line" style="top:36%; animation-duration:22s; animation-delay:-9s"></div>
      <div class="flow-wrap" style="transform:rotate(9deg); top:70%; width:50%;">
        <div class="flow-line" style="top:70%; animation-duration:30s; animation-delay:-24s"></div>
      </div>
    </div>
  </div>
  <div aria-hidden="true" class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="flow-ray" style="left:0; top:14%; width:64vw; transform:rotate(34deg); animation-delay:-2s"></div>
    <div class="flow-ray" style="left:0; top:48%; width:56vw; transform:rotate(3deg); animation-delay:-9s"></div>
    <div class="flow-ray" style="left:0; top:78%; width:62vw; transform:rotate(-28deg); animation-delay:-5s"></div>
    <div class="flow-ray" style="left:12%; top:100%; width:58vw; transform:rotate(-43deg); animation-delay:-13s"></div>
    <div class="flow-ray flow-ray-right" style="right:0; top:19%; width:60vw; transform:rotate(-31deg); animation-delay:-7s"></div>
    <div class="flow-ray flow-ray-right" style="right:0; top:51%; width:54vw; transform:rotate(-1deg); animation-delay:-15s"></div>
    <div class="flow-ray flow-ray-right" style="right:0; top:75%; width:58vw; transform:rotate(25deg); animation-delay:-4s"></div>
    <div class="flow-ray flow-ray-right" style="right:13%; top:100%; width:57vw; transform:rotate(46deg); animation-delay:-11s"></div>
  </div>
  <div aria-hidden="true" class="absolute inset-0 bg-dots-light opacity-70 [mask-image:radial-gradient(ellipse_at_top,black,transparent_70%)] pointer-events-none"></div>
  <div class="max-w-max-width-content mx-auto px-gutter-desktop relative lg:h-full lg:flex lg:flex-col">
    <div data-reveal class="text-center max-w-3xl mx-auto pt-space-3xl pb-space-md lg:pt-space-lg lg:pb-space-xs space-y-space-xs lg:shrink-0">
      <h2 class="font-headline-xl text-headline-xl text-on-surface tracking-tight">Nuestros 3 productos insignia</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant">
        Tres productos vivos, miles de usuarios reales y un mismo estándar de ingeniería.
      </p>
    </div>

    <div data-caro3d class="relative select-none pt-space-xs pb-space-2xl lg:flex-1 lg:min-h-0 lg:flex lg:flex-col lg:justify-center lg:pb-space-sm" data-caro-current="0">
      <div aria-hidden="true" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[42rem] h-[42rem] rounded-full pointer-events-none" style="background:radial-gradient(circle, rgba(201,169,97,0.22), transparent 62%); filter:blur(30px)"></div>
      <div aria-hidden="true" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[56rem] h-[56rem] rounded-full pointer-events-none" style="background:radial-gradient(circle, rgba(201,169,97,0.28), transparent 62%); filter:blur(30px)"></div>
      <div class="caro-perspective caro-viewport relative h-[34rem] sm:h-[30rem] cursor-grab active:cursor-grabbing lg:shrink-0">
        {PRODUCTS.map((p, i) => (
          <article data-caro-face class="caro-face absolute left-1/2 top-1/2 w-[88vw] max-w-[34rem] h-[calc(100%-1rem)] flex flex-col justify-center text-center px-4 sm:px-space-lg lg:px-space-xl pb-space-lg" style={`--fi:${i}; background:linear-gradient(135deg, #000000 0%, #0b0b0e 40%, #5d5d6b 100%)`}>
            <img src={p.logo} width="96" height="96" alt={`${p.name} logo`} class="w-14 h-14 object-contain drop-shadow-lg mt-space-xl mb-space-sm self-center" />
            <span class={`px-3 py-1 rounded-full font-label-sm text-label-sm ${p.badgeBg} ${p.badgeText} font-semibold mb-space-md self-center`}>{p.badge}</span>
            <h3 class="font-display-hero text-display-hero-mobile tracking-tight font-extrabold drop-shadow-sm" style={`color:${p.faceInk}`}>{p.name}</h3>
            <span class="name-rule" aria-hidden="true"></span>
            <p class="font-headline-sm text-headline-sm font-medium mt-space-xs mb-space-md max-w-sm mx-auto" style={`color:${p.faceInkSoft}`}>{p.tagline}</p>
            <div class="space-y-space-xs mb-space-lg text-left mx-auto">
              {p.features.map((f, fi) => (
                <div class="flex items-start gap-2 font-body-sm text-body-sm" style={`color:${p.faceInk}`}>
                  <span class="caro-num">{String(fi + 1).padStart(2, '0')}</span>
                  <span>{f}</span>
                </div>
              ))}
            </div>
            <a data-caro-link class={`inline-flex items-center justify-center gap-2 h-12 px-space-xl rounded-lg bg-white/95 ${p.textColor} font-label-md text-label-md font-semibold hover:bg-white transition-colors mx-auto`} href={p.href} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined}>
              {p.cta}
              <span class="material-symbols-outlined text-lg">arrow_forward</span>
            </a>
          </article>
        ))}
      </div>
      <button data-caro-prev aria-label="Anterior" style="left:max(1.25rem, calc(50% - min(44vw, 17rem) - 5rem)); top:calc(50% - 2rem)" class="hidden sm:flex absolute -translate-y-1/2 z-20 w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-white shadow-lg ring-1 ring-black/5 flex items-center justify-center text-on-surface hover:bg-surface-container transition-colors">
        <span class="material-symbols-outlined">chevron_left</span>
      </button>
      <button data-caro-next aria-label="Siguiente" style="right:max(1.25rem, calc(50% - min(44vw, 17rem) - 5rem)); top:calc(50% - 2rem)" class="hidden sm:flex absolute -translate-y-1/2 z-20 w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-white shadow-lg ring-1 ring-black/5 flex items-center justify-center text-on-surface hover:bg-surface-container transition-colors">
        <span class="material-symbols-outlined">chevron_right</span>
      </button>
      <div class="flex items-center justify-center gap-space-md mt-space-md lg:mt-space-xs relative z-10 lg:shrink-0">
        {PRODUCTS.map((p, i) => (
          <button data-caro-dot={i} aria-label={`Ver ${p.name}`} class="caro-dot"></button>
        ))}
      </div>

      </div>
    </div>
  </div>
</section>

<style is:global>
  @media (min-width: 1024px) {
    .caro-perspective.caro-viewport { height: min(30rem, calc(100dvh - 24rem)); }
  }

  .caro-perspective { perspective: 1500px; touch-action: pan-y; }
  .caro-face {
    transform: translate(-50%, -50%) translateX(var(--tx, 0px)) rotateY(var(--ry, 0deg)) scale(var(--sc, 1));
    transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.9s ease, box-shadow 0.9s ease;
    border-radius: 1.25rem;
    box-shadow: 0 24px 64px -16px rgba(0, 0, 0, 0.3);
    backface-visibility: hidden;
  }
  .caro-face[data-pos="0"] { --tx: 0px; --ry: 0deg; --sc: 1; opacity: 1; z-index: 3; pointer-events: auto; }
  .caro-face[data-pos="-1"] { --tx: -98%; --ry: 55deg; --sc: 0.8; opacity: 0.45; z-index: 2; pointer-events: none; }
  .caro-face[data-pos="1"] { --tx: 98%; --ry: -55deg; --sc: 0.8; opacity: 0.45; z-index: 2; pointer-events: none; }
  .caro-face[data-pos="hidden"] { opacity: 0; z-index: 1; pointer-events: none; }
  .name-rule {
    display: block; height: 3px; width: 5.5rem; margin: 0.65rem auto 0; border-radius: 9999px;
    background: linear-gradient(90deg, #e9cf7a, #b8952e);
    transform: scaleX(0); transform-origin: center;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.25s;
  }
  .caro-face[data-pos="0"] .name-rule { transform: scaleX(1); }
  .caro-face[data-pos="0"] {
    transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.9s ease, box-shadow 0.45s ease;
  }
  .caro-face[data-pos="0"]:hover {
    box-shadow:
      0 0 0 2.5px rgba(233, 207, 122, 0.95),
      0 0 18px rgba(233, 207, 122, 0.55),
      0 0 60px rgba(201, 169, 97, 0.55),
      0 24px 64px -16px rgba(0, 0, 0, 0.35);
  }
  .caro-num {
    color: #b8952e; font-weight: 700; font-size: 0.72rem; letter-spacing: 0.08em;
    min-width: 1.7rem; padding-top: 0.15rem; font-family: 'Plus Jakarta Sans', sans-serif;
  }
  .caro-dot {
    width: 0.65rem; height: 0.65rem; border-radius: 9999px;
    background: rgba(255, 255, 255, 0.82); border: 1px solid rgba(19, 27, 46, 0.42); cursor: pointer;
    box-shadow: 0 1px 3px rgba(19, 27, 46, 0.2);
    transition: all 0.3s ease;
  }
  .caro-dot.is-active {
    background: #1b1b21; border-color: rgba(255, 255, 255, 0.95);
    box-shadow: 0 0 0 2px rgba(27, 27, 33, 0.28), 0 2px 6px rgba(19, 27, 46, 0.34);
    transform: scale(1.35);
  }
</style>
